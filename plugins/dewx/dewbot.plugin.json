{
  "id": "dewx",
  "name": "Dewx Business Tools",
  "description": "32 business tools for CRM, outreach, inbox, finance, HR, analytics, and workflow automation",
  "version": "1.0.0",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "baseUrl": {
        "type": "string",
        "description": "Dewx platform API base URL"
      },
      "orgId": {
        "type": "string",
        "description": "Organization ID"
      },
      "jwt": {
        "type": "string",
        "description": "JWT token for API authentication"
      },
      "proactive": {
        "type": "object",
        "properties": {
          "enabled": { "type": "boolean" },
          "staleDealDays": { "type": "number" },
          "dailySummaryHour": { "type": "number" },
          "alertChannel": { "type": "string" }
        }
      }
    }
  }
}
